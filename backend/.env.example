# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (from Supabase → Settings → Database → URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Also used under NEXT_PUBLIC_ prefix for web-app compat
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank to use in-memory fallback (fine for local dev)
REDIS_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@carmazium.uk

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
HEALTH_SELF_URL=http://localhost:3001
