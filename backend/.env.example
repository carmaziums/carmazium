# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank to use in-memory fallback (fine for local dev)
REDIS_URL=

# ── AI vehicle-photo selection ────────────────────────────────────────────────
# Server-side only. Used to identify the best front-facing listing cover photo.
OPENAI_API_KEY=sk-proj-...
OPENAI_VISION_MODEL=gpt-5.6-luna

# ── Live UK market valuation enrichment ──────────────────────────────────────
# Vehicle valuations attempt a fresh AI-assisted web search for current UK
# comparable adverts and blend that evidence with CarMazium market data.
# This is enrichment, not an availability dependency: if live search is
# unavailable the API still returns a LOW-confidence deterministic guide.
OPENAI_WEB_VALUATION_MODEL=gpt-5.6-luna
# Optional: override the AI model used to research registration-specific trim/spec.
OPENAI_VEHICLE_SPEC_MODEL=gpt-5.6-luna

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@carmazium.com

# ── Backup ────────────────────────────────────────────────────────────────────
# Email address to notify when the weekly DB backup cron fails
ADMIN_BACKUP_EMAIL=airafadil619@gmail.com

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
HEALTH_SELF_URL=http://localhost:3001


# ── TradeXchange live-service availability ────────────────────────────────────
# Same names and values as the frontend Vercel environment.
# Core services default ON if omitted. Keep these explicitly true in managed
# environments. Set only the affected service to false for an emergency stop
# on NEW requests; existing jobs/enquiries remain manageable.
NEXT_PUBLIC_FEATURE_DELIVERY=true
NEXT_PUBLIC_FEATURE_INSPECTION=true
NEXT_PUBLIC_FEATURE_FINANCE_SERVICES=true
NEXT_PUBLIC_FEATURE_WARRANTY=true
