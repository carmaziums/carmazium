# ─────────────────────────────────────────────────────────────────────────────
# CarMazium — frontend environment variables
#
# Copy to `.env.local` for local development. Everything prefixed
# NEXT_PUBLIC_ is inlined into the client bundle at build time and is
# therefore PUBLIC — never put a secret behind that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API
NEXT_PUBLIC_API_URL=https://carmazium-hjoh9w.fly.dev

# Supabase (auth + image storage)
NEXT_PUBLIC_SUPABASE_URL=https://bwtnzmevjlowwronylxm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── TradeXchange service availability ────────────────────────────────────────
# All four are core live services and default to ON if omitted.
# Keep them explicitly true in managed environments for clarity.
# Set only the affected service to false for an emergency customer-facing kill
# switch. Values other than true/false are rejected at build time.
NEXT_PUBLIC_FEATURE_DELIVERY=true
NEXT_PUBLIC_FEATURE_INSPECTION=true
NEXT_PUBLIC_FEATURE_FINANCE_SERVICES=true
NEXT_PUBLIC_FEATURE_WARRANTY=true

# ─── Analytics & advertising ─────────────────────────────────────────────────
# OWNERSHIP RULE: Google/GA4/GTM IDs and conversion actions should ultimately
# belong to a CarMazium-controlled account. Do not leave permanent ownership
# with a developer, agency, freelancer, or other third party.
#
# META EXCEPTION DURING REPAIR: the existing production Meta Pixel may be kept
# temporarily to preserve campaign history while its event semantics are
# repaired. CarMazium should still obtain permanent Business Manager access to
# that Pixel (or migrate later) so the company is not dependent on a third party.
#
# Meta/TikTok are hard-gated by marketing consent. Google uses Consent Mode v2:
# the Google tag may load with storage denied and is upgraded only after consent.
# See components/analytics/GoogleConsentMode.tsx and context/ConsentContext.tsx.

# Google Analytics 4 — target CarMazium-owned GA4 web stream (G-...)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager — target CarMazium-owned web container (GTM-...)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Dataset / Pixel — existing repaired production Pixel may be retained
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel — only if CarMazium owns and uses one
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Google Ads conversion tracking ──────────────────────────────────────────
# The Ads account ID loads the Google Ads destination. Explicit labels below
# override the temporary legacy production fallbacks in lib/googleAds.ts.
# Those fallbacks exist only to avoid interrupting the live Google Ads campaign
# before CarMazium-owned replacement actions have been created and verified.
# Remove the fallbacks after the controlled migration is complete.
#
# WHERE TO FIND A LABEL: Google Ads → Goals → Conversions → Summary → click the
# conversion action → Tag setup → Use Google Tag Manager (or view the gtag
# snippet). You'll see a value such as:
#
#     send_to: 'AW-123456789/AbC-D_efG-h12_34-567'
#                           └─────────────────────┘
#                           only this part goes below

# Google Ads destination ID (AW-...). During migration this may still be the
# existing live destination until the CarMazium-owned replacement is verified.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Primary money conversion. Fires on cleared Stripe checkout and carries
# value/currency/transaction_id. A configured value overrides the legacy label.
NEXT_PUBLIC_GADS_LABEL_PURCHASE=

# Primary seller lead conversion. Fires when a genuine seller completes the
# listing wizard. Admin-created listings are excluded from paid-media tracking.
NEXT_PUBLIC_GADS_LABEL_LISTING_SUBMITTED=

# Completed account registration. Fires only when the backend confirms a new
# user was actually created, so returning logins cannot count as conversions.
NEXT_PUBLIC_GADS_LABEL_SIGNUP=

# Top-of-funnel micro-conversion: vehicle registration entered and valuation
# data returned. If enabled, normally keep this Secondary so bidding does not
# optimise toward a cheap low-intent action instead of real seller outcomes.
NEXT_PUBLIC_GADS_LABEL_VALUATION=
