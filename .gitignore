# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
env.txt
**/env.txt

# EAS / app store credentials — never commit real service-account keys or
# signing secrets (eas.json itself only holds placeholder IDs, safe to commit)
google-service-account*.json
*-service-account.json
*.p8
*.p12
*.mobileprovision

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
