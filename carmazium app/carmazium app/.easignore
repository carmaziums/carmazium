# EAS installs its own node_modules — exclude ALL node_modules at every level
**/node_modules/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Local env files (secrets go in eas.json env or EAS dashboard)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test / coverage output
coverage/
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/

# Planning / docs
.planning/
Downloads/
DEVELOPER_SETUP.md

# Native dirs — let EAS regenerate via expo prebuild (avoids stale patches)
**/android/
**/ios/

# Monorepo: exclude everything outside the mobile app (EAS archives from git root)
backend/
api-server/
src/
public/
supabase-email-templates/
docs/
CarMazium Design System/
CarMazium*/
*.md
*.txt
*.log
*.pem
next.config.*
next-env.d.ts
tsconfig.json
tsconfig.tsbuildinfo
eslint.config.*
postcss.config.*
render.yaml
package.json
package-lock.json
out/
build/
dist/
.next/
