# Expo / React Native
node_modules/
.expo/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# EAS / store credentials — never commit real keys
google-service-account*.json
*-service-account.json

# Android release signing — keystore + plaintext passwords, never commit.
# Also covered individually by *.jks/*.p12 above, but the whole folder is
# ignored too so a stray backup copy or a differently-named keystore can't
# slip through.
keystores/

# Environment — developer creates their own .env
.env
.env.local
.env.*.local

# Native build artefacts (generated by EAS / bare workflow)
android/
ios/
.xcode.env.local

# Misc
.DS_Store
*.tsbuildinfo
Downloads/
*.jpg
*.jpeg
!assets/**/*.jpg

# Scratch/manual APK patching work + QA docs — not source, not for git
scratch_apk_work/
scratch_bundle_out/
*.docx
