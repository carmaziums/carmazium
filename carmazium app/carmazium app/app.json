{
  "expo": {
    "name": "Carmazium",
    "slug": "carmazium",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "icon": "./assets/images/icon.png",
    "scheme": "carmazium",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f0ab914b-3433-4816-80a2-0a94e6c6a066",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.carmazium.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access for vehicle photo uploads",
        "NSPhotoLibraryUsageDescription": "Photo library access for vehicle photos",
        "NSLocationWhenInUseUsageDescription": "Location access to show vehicles near you"
      }
    },
    "android": {
      "package": "uk.carmazium.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "carmazium"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "carmazium.com",
              "pathPrefix": "/auth/accept-invite"
            },
            {
              "scheme": "https",
              "host": "www.carmazium.com",
              "pathPrefix": "/auth/accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "f0ab914b-3433-4816-80a2-0a94e6c6a066"
      }
    },
    "plugins": [
      "./plugins/withAndroidProguardRules",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidGradleMemory",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-secure-store",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF0037",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Carmazium"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.uk.carmazium.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "jvmHeapSize": "2048m",
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location access to show vehicles near you"
        }
      ]
    ],
    "owner": "pizn-01s-team"
  }
}
