    },
    "plugins": [
      "./plugins/withAndroidProguardRules",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidGradleMemory",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CarMazium lets you choose photos to upload for vehicle listings, chat, profile, verification and evidence.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-updates",
